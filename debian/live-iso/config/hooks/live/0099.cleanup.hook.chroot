#! /usr/bin/env sh

set -e

# Only purge what is installed: apt-get fails on unknown packages
installed=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' \
	apt-utils \
	dselect \
	info \
	man-db \
	manpages \
	nano \
	rsyslog \
	wget \
	2>/dev/null | awk '/^ii/ { print $2 }')

if [ -n "${installed}" ]; then
	apt-get purge --yes ${installed}
fi

apt-get autoremove --purge --yes

find / -xdev -name '*~' -type f -delete

rm -rf /usr/include/*
rm -rf /usr/share/groff/*
rm -rf /usr/share/doc/*
rm -rf /usr/share/locale/*
rm -rf /usr/share/man/*
rm -rf /usr/share/i18n/*
rm -rf /usr/share/info/*
rm -rf /usr/share/lintian/*
rm -rf /usr/share/linda/*
rm -rf /var/cache/man/*
rm -rf /var/cache/apt/*
rm -rf /var/log/*
