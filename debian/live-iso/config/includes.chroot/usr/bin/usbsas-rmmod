#! /usr/bin/env sh

set -eu

# The modprobe configuration of usbsas-server is moved away at build time so
# that the live system can boot from a USB drive, restore it and unload the
# USB storage modules.
install -m 644 /usr/share/usbsas/modprobe-usbsas.conf /etc/modprobe.d/usbsas.conf

for mod in uas usb_storage; do
	if grep -q "^${mod} " /proc/modules; then
		rmmod "${mod}"
	fi
done

# usbsas-server requires this unit: fail if a module is still loaded
if grep -qE '^(uas|usb_storage) ' /proc/modules; then
	echo "USB storage modules still loaded" >&2
	exit 1
fi
