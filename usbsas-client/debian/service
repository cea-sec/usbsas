[Unit]
Description=usbsas-client kiosk
After=systemd-user-sessions.service plymouth-quit-wait.service
Before=graphical.target
ConditionPathExists=/dev/tty0
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty2.service
After=getty@tty2.service

[Service]
Type=simple
User=usbsas-client
WorkingDirectory=/var/lib/usbsas-client
RuntimeDirectory=usbsas-client
RuntimeDirectoryMode=0700
Environment="RUST_LOG=info,wgpu_hal=error,iced_winit=error,iced_wgpu=error,wgpu_core=error"
Environment=XDG_RUNTIME_DIR=/run/usbsas-client
PAMName=usbsas-client
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UnsetEnvironment=TERM
UtmpIdentifier=tty2
UtmpMode=user
StandardOutput=journal
ExecStart=/usr/bin/cage -d /usr/bin/usbsas-client -- --fullscreen
ExecStartPre=/usr/bin/chvt 2
Restart=always
# Reports contain users' file names
UMask=0027

# Resources and devices.
# With PAMName=, pam_systemd moves processes to a session scope, out of the
# cgroup of this service: cgroup settings only apply to them through
# user-<uid>.slice.d/50-usbsas-client.conf, written by postinst. Keep both in
# sync. The ones here still apply before the move (opening the tty), and if PAM
# isn't configured with pam_systemd.
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
TasksMax=512
DevicePolicy=closed
DeviceAllow=/dev/tty2 rw
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
LimitCORE=0

# File system.
# ProtectHome= can't be used: it hides /run/user, and pam_systemd overrides
# XDG_RUNTIME_DIR with /run/user/<uid>. Connecting to the socket in /run/usbsas
# doesn't need it to be writable (and it must not be listed here: the directory
# is recreated each time the server restarts).
ProtectSystem=strict
InaccessiblePaths=-/home -/root
PrivateTmp=yes
ReadWritePaths=/var/lib/usbsas-client -/var/lib/usbsas/reports -/run/user
NoExecPaths=/
ExecPaths=/usr -/bin -/sbin -/lib -/lib64

# Kernel
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible

# Privileges and processes.
# MemoryDenyWriteExecute= can't be used: Mesa's software rendering (no GPU,
# virtual machines) compiles shaders to executable memory.
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
PrivateIPC=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Network. PrivateNetwork= can't be used: udev events, needed to detect the
# input devices created by hid-dealer, are only sent in the host network
# namespace.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Syscalls. The client sandboxes itself: landlock and seccomp aren't in
# @system-service and must remain available. @resources is kept, the client's
# seccomp filter allows some of them for its threads. Errors rather than kills:
# cage checks it can't get root back by calling setuid(0).
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self seccomp
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical.target
