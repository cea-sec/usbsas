[Unit]
Description=SAS USB Server
After=network-online.target
# DeviceAllow=char-usb_device is resolved when the service starts, only if
# usbcore is already loaded.
Wants=modprobe@usbcore.service
After=modprobe@usbcore.service

[Service]
User=usbsas
ExecStart=/usr/libexec/usbsas-usbsas -s
Environment="RUST_LOG=info"
WorkingDirectory=/usr/libexec
RuntimeDirectory=usbsas
# The client connects through the usbsas group
RuntimeDirectoryMode=0750
Restart=always
# Working files contain users' data
UMask=0027

# Resources.
MemoryHigh=3G
MemoryMax=4G
# Users' data must not end up in swap or core dumps
MemorySwapMax=0
LimitCORE=0
TasksMax=512

# File system.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/usbsas -/usbsas_data
NoExecPaths=/
ExecPaths=/usr -/bin -/sbin -/lib -/lib64

# Devices
DevicePolicy=closed
DeviceAllow=char-usb_device rw

# Kernel
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible

# Privileges and processes
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Network. PrivateNetwork= can't be used: udev events are only sent in the host
# network namespace, and processes need it to reach remote servers.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

# Syscalls. usbsas processes sandbox themselves: landlock and seccomp aren't in
# @system-service and must remain available.
SystemCallArchitectures=native
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self seccomp
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
