# Analyseur CENTRAL partagé entre plusieurs bornes (/etc/barbacane/analyzer.toml du serveur).
# Mêmes réglages que l'analyseur local, plus l'écoute réseau en TLS et les jetons des bornes.
listen = "0.0.0.0:8443"
work_dir = "/var/lib/barbacane/analyzer"
clamd_socket = "/run/clamav/clamd.ctl"
yara_rules_dir = "/var/lib/barbacane/yara"
seven_zip = "/usr/bin/7z"
bwrap = "/usr/bin/bwrap"
reports_dir = "/var/lib/barbacane/rapports"

[server]
tls_cert = "/etc/barbacane/tls/serveur.pem"
tls_key = "/etc/barbacane/tls/serveur.key"
# Une ligne par borne : « <jeton de 32 caractères ou plus> <nom de la borne> »
# (générer un jeton : head -c 32 /dev/urandom | base64 | tr -d '/+=')
tokens_file = "/etc/barbacane/jetons"
