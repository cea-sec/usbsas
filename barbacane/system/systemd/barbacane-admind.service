[Unit]
Description=Barbacane : service d'administration (PIN, mises à jour, enrôlement)
After=local-fs.target

[Service]
# root : applique les mises à jour (apt), redémarre les services, éteint la borne.
ExecStart=/usr/bin/barbacane-admind -c /etc/barbacane/admind.toml
Environment=RUST_LOG=info
RuntimeDirectory=barbacane
RuntimeDirectoryMode=0755
StateDirectory=barbacane/admin barbacane/export
# Règles YARA : lisibles par l'analyseur (0755, créé par le postinst), pas en StateDirectory (0750)
ReadWritePaths=/var/lib/barbacane/yara
StateDirectoryMode=0750
UMask=0022
NoNewPrivileges=no
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressAllow=localhost
IPAddressDeny=any
SystemCallArchitectures=native
Restart=on-failure

[Install]
WantedBy=multi-user.target
