syntax = "proto3";
package fs2dev;
import "common.proto3";

// Protocol of fs2dev, the only process writing to the destination USB device.
// It starts locked and opens the device when unlocked with its bus and device
// numbers.


/* Requests */

message RequestEnd {
};

// Get the size of the device.
message RequestDevSize {
};

// Write the file system image to the device (only the sectors set in the
// loaded bit vector). Status responses follow.
message RequestWriteFs {
};

// Fill the device with zeros. Status responses follow.
message RequestWipe {
};

// Load a chunk of the bit vector of sectors to write (see
// writedst.RequestBitVec).
message RequestLoadBitVec {
  bytes chunk = 1;
  bool last = 2;
};

message Request {
  oneof msg {
    RequestEnd End = 1;
    RequestDevSize DevSize = 2;
    RequestWriteFs WriteFs = 3;
    RequestWipe wipe = 4;
    RequestLoadBitVec LoadBitVec = 5;
  }
};



/* Responses */
message ResponseDevSize {
  // Size in bytes
  uint64 size = 1;
};

message ResponseWriteFs {
};

message ResponseWipe {
};

message ResponseLoadBitVec {
};

message Response {
  oneof msg {
    common.ResponseEnd End = 1;
    common.ResponseError Error = 2;
    ResponseDevSize DevSize = 3;
    ResponseWriteFs WriteFs = 4;
    ResponseWipe Wipe = 5;
    ResponseLoadBitVec LoadBitVec = 6;
    common.ResponseStatus Status = 7;
  }
};
