syntax = "proto3";
package analyzer;
import "common.proto3";

// Protocol of the analyzer, which sends the session tar to a remote analyzer
// (antivirus) and gets its report.

/* Requests */

// Upload the tar and wait for the analysis. Status responses follow.
message RequestAnalyze {
  // User id
  string id = 1;
};

// Get the analysis report.
message RequestReport {
};

message RequestEnd {
};

message Request {
  oneof msg {
    RequestAnalyze Analyze = 1;
    RequestReport Report = 2;
    RequestEnd End = 3;
  }
};


/* Response */

message ResponseAnalyze {
}

message ResponseReport {
  // Not set if the analysis failed
  common.AnalyzeReport report = 1;
}

message Response {
  oneof msg {
    ResponseAnalyze Analyze = 1;
    ResponseReport Report = 2;
    common.ResponseEnd End = 3;
    common.ResponseError Error = 4;
    common.ResponseStatus Status = 5;
  }
};
