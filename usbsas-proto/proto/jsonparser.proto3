syntax = "proto3";
package jsonparser;
import public "common.proto3";

// Protocol of the jsonparser, spawned by the analyzer to parse the JSON
// responses of the remote server in a separate sandboxed process.

// Response of the remote analyzer to an upload or a status request.
message SrvResp {
  string status = 1;
  // Analysis identifier
  optional string id = 2;
};

// Requests

// Parse a server response.
message RequestParseResp {
  bytes data = 1;
};

// Parse an analysis report.
message RequestParseReport {
  bytes data = 1;
};

message RequestEnd {
};

message Request {
  oneof msg {
    RequestParseResp ParseResp = 1;
    RequestParseReport ParseReport = 2;
    RequestEnd End = 3;
  }
};

// Responses

message ResponseParseResp {
  SrvResp resp = 1;
};

message ResponseParseReport {
  common.AnalyzeReport report = 1;
};

message Response {
  oneof msg {
    ResponseParseResp ParseResp = 1;
    ResponseParseReport ParseReport = 2;
    common.ResponseStatus Status = 3;
    common.ResponseEnd End = 4;
    common.ResponseError Error = 5;
  }
};
