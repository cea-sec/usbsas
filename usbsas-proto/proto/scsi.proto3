syntax = "proto3";
package scsi;
import "common.proto3";

// Protocol between scsi2files and dev2scsi, which reads sectors of the USB
// device. dev2scsi starts locked and opens the device when unlocked with its
// bus and device numbers, then sends ResponseOpenDevice.



/* Requests */

message RequestEnd {
};

// Unused, the device is opened when dev2scsi is unlocked.
message RequestOpenDevice {
  uint32 vendorid = 1;
  uint32 productid = 2;
};

message RequestPartitions {
};

// Read raw sectors.
message RequestReadSectors {
  // First sector
  uint64 offset = 1;
  // Number of sectors
  uint64 count = 2;
};

message Request {
  oneof msg {
    RequestEnd End = 1;
    RequestOpenDevice OpenDevice = 2;
    RequestPartitions Partitions = 3;
    RequestReadSectors ReadSectors = 4;
  }
};


/* Responses */

message ResponseOpenDevice {
  // Sector size in bytes
  uint64 block_size = 1;
  // Device size in bytes
  uint64 dev_size = 2;
};

message ResponsePartitions {
  repeated common.PartitionInfo partitions = 1;
};

message ResponseReadSectors {
  bytes data = 1;
};

message Response {
  oneof msg {
    common.ResponseError Error = 1;
    ResponseOpenDevice OpenDevice = 2;
    common.ResponseEnd End = 3;
    ResponsePartitions Partitions = 4;
    ResponseReadSectors ReadSectors = 5;
    common.ResponseStatus Status = 6;
  }
};
