syntax = "proto3";
package uploader;
import public "common.proto3";

// Protocol of the uploader, which uploads the session tar (or clean tar) to a
// destination network.

/* Requests */

// Upload the tar. Status responses follow.
message RequestUpload {
  // User id
  string id = 1;
  common.Network network = 2;
};

message RequestEnd {
};

message Request {
  oneof msg {
    RequestUpload Upload = 1;
    RequestEnd End = 2;
  }
};


/* Response */

message ResponseUpload {
}

message Response {
  oneof msg {
    ResponseUpload Upload = 1;
    common.ResponseStatus Status = 2;
    common.ResponseEnd End = 3;
    common.ResponseError Error = 4;
  }
};
