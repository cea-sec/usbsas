syntax = "proto3";
package common;

// Types shared by every protocol.

// Type of a file.
enum FileType {
  // Unsupported type (symlink, device...), not transferred
  OTHER = 0;
  REGULAR = 1;
  DIRECTORY = 2;
  // File generated by usbsas (e.g. JSON report), not read from the source
  METADATA = 3;
};

// Output of a transfer given to the post copy command.
enum OutFileType {
  TAR = 0;
  FS = 1;
};

// File system to create on a destination USB device.
enum FsType {
  NTFS = 0;
  FAT = 1;
  EXFAT = 2;
};

// Step of a long running operation, sent in ResponseStatus.
enum Status {
  // Copying files from the source into the session tar
  READ_SRC = 0;
  // Downloading the archive from a network source
  DL_SRC = 1;
  // Uploading the tar to the analyzer
  UPLOAD_AV = 2;
  // Waiting for the analysis result
  ANALYZE = 3;
  // Writing files into the file system image
  MK_FS = 4;
  // Writing files into the clean tar
  MK_ARCHIVE = 5;
  // Writing the file system image to the destination device
  WRITE_DST = 6;
  // Uploading the tar to the destination network
  UPLOAD_DST = 7;
  // Executing the destination command
  EXEC_CMD = 8;
  // Filling the device with zeros
  WIPE = 9;
  // Copying the device into a disk image
  DISK_IMG = 10;
  // The whole operation is done, a report can be requested
  ALL_DONE = 11;
  // Unrecognized status
  UNKNOWN = 12;
};

// Metadata of a file, as listed by ReadDir.
message FileInfo {
  // Full path of the file
  string path = 1;
  FileType ftype = 2;
  // Size in bytes
  uint64 size = 3;
  // Modification time (Unix timestamp, seconds)
  int64 timestamp = 4;
};

// A USB mass storage device.
message UsbDevice {
  // USB bus number (with devnum, identifies the device on the host)
  uint32 busnum = 1;
  uint32 devnum = 2;
  uint32 vendorid = 3;
  uint32 productid = 4;
  string manufacturer = 5;
  string description = 6;
  string serial = 7;
  // Size in bytes, set once the device is opened
  optional uint64 dev_size = 8;
  // Sector size in bytes, set once the device is opened
  optional uint64 block_size = 9;
  // Can be used as a transfer source
  bool is_src = 10;
  // Can be used as a transfer destination
  bool is_dst = 11;
};

// A remote server, source (download) or destination (upload) of transfers,
// from the configuration.
message Network {
  string url = 1;
  // Kerberos service name, if Kerberos authentication is used
  optional string krb_service_name = 2;
  // Short name displayed to the user
  string title = 3;
  // Long description displayed to the user
  string description = 4;
  bool is_src = 5;
  bool is_dst = 6;
};

// A command executed on the transferred files, from the configuration.
message Command {
  // Path of the executable
  string bin = 1;
  // Arguments, `%SOURCE_FILE%` is replaced by the output file path
  repeated string args = 2;
  string title = 3;
  string description = 4;
  bool is_src = 5;
  bool is_dst = 6;
};

// A local directory used as a transfer source, from the configuration.
message LocalDir {
  string path = 1;
  string title = 2;
  string description = 3;
  bool is_src = 4;
  bool is_dst = 5;
};

// A source or destination of a transfer.
message Device {
  oneof device {
    Network network = 1;
    Command command = 2;
    UsbDevice usb = 3;
    LocalDir local_dir = 4;
  }
  // Identifier of the device (hash of its content), used in requests
  uint64 id = 5;
};

// A partition of a USB device.
message PartitionInfo {
  // Size in bytes
  uint64 size = 1;
  // First sector
  uint64 start = 2;
  // MBR partition type (0 for GPT or no partition table)
  uint32 ptype = 3;
  // Partition name
  string name_str = 4;
  // Human readable partition type
  string type_str = 5;
}

// Answer to RequestEnd, the responder exits after sending it.
message ResponseEnd {
};

// Error, can be sent in response to any request.
message ResponseError {
  string err = 1;
};

// Progress of a long running operation. The responder sends them until one
// has `done` set.
message ResponseStatus {
  // The step is over
  bool done = 1;
  // Progress, usually in bytes
  uint64 current = 2;
  // Total, usually in bytes
  uint64 total = 3;
  Status status = 4;
};

// Reports

// Antivirus used by the analyzer.
message Antivirus {
  string version = 1;
  string database_version = 2;
  optional string database_timestamp = 3;
};
// Analysis result of a file.
message FileStatus {
  // "CLEAN" or "DIRTY"
  string status = 1;
  optional string sha256 = 2;
};

// Report returned by the remote analyzer.
message AnalyzeReport {
  // Analysis identifier
  string id = 1;
  // Analysis status ("scanned" when done)
  string status = 2;
  // Report format version (only 2 is supported)
  optional uint32 version = 3;
  // Antiviruses used, by name
  map <string, Antivirus> antivirus = 4;
  // Result of each file, by path (without leading '/')
  map <string, FileStatus> files = 5;
};

// Device descriptions included in reports.
message UsbDeviceReport {
  uint32 vendorid = 1;
  uint32 productid = 2;
  string manufacturer = 3;
  string description = 4;
  string serial = 5;
};

message NetworkReport {
  string title = 1;
  string description = 2;
};

message CommandReport {
  string title = 1;
  string description = 2;
};

message LocalDirReport {
  string title = 1;
  string description = 2;
};

message DeviceReport {
  oneof device {
    UsbDeviceReport usb = 1;
    NetworkReport network = 2;
    CommandReport command = 3;
    LocalDirReport local_dir = 4;
  }
}

// Metadata of a transferred file in a report.
message FileInfoReport {
  uint64 size = 1;
  int64 timestamp = 2;
  optional string sha256 = 3;
}

// Report of an operation (transfer, wipe or disk image), serialized in JSON
// to be saved or written on the destination.
message TransferReport {
  // `<operation>_<datetime>_<transfer_id>`
  string title = 1;
  // Date and time (YYYYMMDDhhmmssms, UTC)
  string datetime = 2;
  // Unix timestamp (seconds)
  int64 timestamp = 3;
  string hostname = 4;
  // "success" or the reason of the failure
  string status = 5;
  optional string user = 6;
  // Session id
  string transfer_id = 7;
  DeviceReport source = 8;
  DeviceReport destination = 9;
  // Transferred files, by path
  map <string, FileInfoReport> files_info = 11;
  // Paths of the transferred files
  repeated string file_names = 12;
  // Files that couldn't be transferred
  repeated string errors = 13;
  // Files excluded by the configured filters
  repeated string filtered = 14;
  // Files rejected by the analyzer
  repeated string rejected = 15;
  optional AnalyzeReport analyzereport = 16;
  // Directories at the maximum depth whose content wasn't transferred
  repeated string depth_exceeded = 17;
};
