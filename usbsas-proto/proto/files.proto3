syntax = "proto3";
package files;
import "common.proto3";

// Protocol of the processes reading files from a source: scsi2files (USB
// device), local2files (local directory) and tar2files (session tar).
// Operations are modeled after FUSE (getattr, readdir, read).


/* Requests */

message RequestEnd {
};

// Open a USB device (scsi2files).
message RequestOpenDevice {
  uint32 busnum = 1;
  uint32 devnum = 2;
};

// Open a local directory (local2files).
message RequestOpenLocalDir {
  string path = 1;
};

// List the partitions of the opened device.
message RequestPartitions {
};

// Open the file system of a partition.
message RequestOpenPartition {
  // Index in ResponsePartitions
  uint32 index = 1;
};

message RequestGetAttr {
  string path = 1;
};

message RequestReadDir {
  string path = 1;
};

// Read a part of a file.
message RequestReadFile {
  string path = 1;
  // Bytes to read, at most READ_FILE_MAX_SIZE (usbsas-utils)
  uint64 size = 2;
  // Offset in bytes
  uint64 offset = 3;
};

// Read raw sectors of the opened device (disk image).
message RequestReadSectors {
  // First sector
  uint64 offset = 1;
  // Number of sectors
  uint64 count = 2;
};

message Request {
  oneof msg {
    RequestEnd End = 1;
    RequestOpenDevice OpenDevice = 2;
    RequestPartitions Partitions = 3;
    RequestOpenPartition OpenPartition = 4;
    RequestGetAttr GetAttr = 5;
    RequestReadDir ReadDir = 6;
    RequestReadFile ReadFile = 7;
    RequestReadSectors ReadSectors = 8;
    RequestOpenLocalDir OpenLocalDir = 9;
  }
};


/* Responses */
message ResponseOpenDevice {
  // Sector size in bytes
  uint64 block_size = 1;
  // Device size in bytes
  uint64 dev_size = 2;
};

message ResponseOpenLocalDir {
};

message ResponseOpenPartition {
};

message ResponsePartitions {
  repeated common.PartitionInfo partitions = 2;
};

message ResponseGetAttr {
  common.FileType ftype = 1;
  uint64 size = 2;
  int64 timestamp = 3;
};

message ResponseReadDir {
  repeated common.FileInfo filesinfo = 1;
};

message ResponseReadFile {
  bytes data = 1;
};

message ResponseReadSectors {
  bytes data = 1;
};

message Response {
  oneof msg {
    common.ResponseEnd End = 1;
    common.ResponseError Error = 2;
    ResponseOpenDevice OpenDevice = 3;
    ResponseOpenPartition OpenPartition = 4;
    ResponsePartitions Partitions = 5;
    ResponseGetAttr GetAttr = 6;
    ResponseReadDir ReadDir = 7;
    ResponseReadFile ReadFile = 8;
    ResponseReadSectors ReadSectors = 9;
    common.ResponseStatus Status = 10;
    ResponseOpenLocalDir OpenLocalDir = 11;
  }
};
