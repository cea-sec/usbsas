syntax = "proto3";
package downloader;
import "common.proto3";

// Protocol of the downloader, which downloads an archive from the source
// network into the session tar.

/* Requests */

// Download the archive found with ArchiveInfos. Status responses follow.
message RequestDownload {
};

// Get information about the archive to download.
message RequestArchiveInfos {
  // Path of the archive on the server (`<user id>/<pin>`)
  string path = 1;
};

message RequestEnd {
};

message Request {
  oneof msg {
    RequestDownload Download = 1;
    RequestArchiveInfos ArchiveInfos = 2;
    RequestEnd End = 3;
  }
};


/* Response */

message ResponseDownload {
}

message ResponseArchiveInfos {
  // Size in bytes
  uint64 size = 1;
}

message Response {
  oneof msg {
    ResponseDownload Download = 1;
    common.ResponseStatus Status = 2;
    ResponseArchiveInfos ArchiveInfos = 3;
    common.ResponseEnd End = 4;
    common.ResponseError Error = 5;
  }
};
