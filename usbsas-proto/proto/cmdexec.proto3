syntax = "proto3";
package cmdexec;
import "common.proto3";

// Protocol of cmdexec, which executes the commands of the configuration on the
// transfer output.

/* Requests */

// Execute the destination command on the tar.
message RequestExec {
};

// Execute the post copy command.
message RequestPostCopyExec {
  // Output given to the command (tar or file system image)
  common.OutFileType outfiletype = 1;
};

message RequestEnd {
};

message Request {
  oneof msg {
    RequestExec Exec = 1;
    RequestPostCopyExec PostCopyExec = 2;
    RequestEnd End = 3;
  }
};


/* Response */

message ResponseExec {
}

message ResponsePostCopyExec {
}

message Response {
  oneof msg {
    ResponseExec Exec = 1;
    ResponsePostCopyExec PostCopyExec = 2;
    common.ResponseStatus Status = 3;
    common.ResponseEnd End = 4;
    common.ResponseError Error = 5;
  }
};
